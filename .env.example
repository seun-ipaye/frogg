DISCORD_TOKEN=
DATABASE_PATH=frogg.db
TOPGG_TOKEN=

# Public listings repo sync (all optional - see "Publishing listings" in the README)
# Fine-grained token limited to the LISTINGS repo, Contents: read/write. Never commit it.
GITHUB_TOKEN=
# owner/name of the public listings repo (NOT this bot's repo)
GITHUB_REPO=
GITHUB_BRANCH=main
# Local preview: write the generated files into this folder instead of pushing. Takes priority over GITHUB_*.
LISTINGS_OUTPUT_DIR=
LISTINGS_SYNC_INTERVAL_MINUTES=30
# "Add Frogg to your server" link shown in the listings README (see the README for where to get it)
BOT_INVITE_URL=
# Optional overrides for the "built by" line of the listings README (LinkedIn has a default; GitHub is hidden unless set)
CREATOR_LINKEDIN_URL=
CREATOR_GITHUB_URL=
# Only change when SimplifyJobs renames its yearly repo
COOP_TRACKER_REPO=Summer2027-Internships
